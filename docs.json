{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Proxy",
  "colors": {
    "primary": "#d4a574",
    "light": "#85d7ff",
    "dark": "#85d7ff"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://useproxy.ai"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system",
    "rounded": "default",
    "icons": {
      "library": "fontawesome",
      "style": "regular"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "system-overview",
              "quickstart",
              "payment-flow",
              "authentication",
              "errors"
            ]
          },
          {
            "group": "User Onboarding",
            "icon": "user-plus",
            "pages": [
              "guides/user-onboarding",
              "concepts/users",
              "guides/deposits-withdrawals"
            ]
          },
          {
            "group": "Core Concepts",
            "icon": "book",
            "pages": [
              "concepts/agents",
              "concepts/cards",
              "concepts/spending-intents",
              "concepts/security-attestation",
              "concepts/transactions",
              "concepts/disputes",
              "concepts/policies",
              "concepts/rake",
              "concepts/risk-policies",
              "concepts/auditors",
              "concepts/webhooks"
            ]
          },
          {
            "group": "Guides",
            "icon": "map",
            "pages": [
              "guides/create-your-first-card",
              "guides/statements",
              "best-practices",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "code",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "User Verification (KYC)",
            "icon": "user-check",
            "openapi": "openapi.json",
            "pages": [
              "POST /v1/verification/user",
              "GET /v1/verification/user/{userId}",
              "PATCH /v1/verification/user/{userId}",
              "PUT /v1/verification/user/{userId}/document",
              "GET /v1/verification/user/{userId}/link"
            ]
          },
          {
            "group": "Business Verification (KYB)",
            "icon": "building",
            "openapi": "openapi.json",
            "pages": [
              "GET /v1/verification/business",
