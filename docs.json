{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Proxy",
  "colors": {
    "primary": "#1a1a1a",
    "light": "#85d7ff",
    "dark": "#85d7ff"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://useproxy.ai"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system",
    "rounded": "default"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "gradient"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "openapi": "openapi.json",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "icon": "book",
            "pages": [
              "concepts/customers",
              "concepts/agents",
              "concepts/cards",
              "concepts/intents",
              "concepts/policies",
              "concepts/transactions",
              "concepts/balances",
              "concepts/disputes",
              "concepts/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "code",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Customers",
            "icon": "user",
            "pages": [
              "GET /customers",
              "POST /customers",
              "GET /customers/{customerId}",
              "PATCH /customers/{customerId}",
              "DELETE /customers/{customerId}",
              "GET /customers/{customerId}/balances",
              "GET /customers/{customerId}/funding-instructions"
            ]
          },
          {
            "group": "Agents",
            "icon": "robot",
            "pages": [
              "GET /agents",
              "POST /agents",
              "GET /agents/{agentId}",
              "PATCH /agents/{agentId}",
              "DELETE /agents/{agentId}"
            ]
          },
          {
            "group": "Cards",
            "icon": "credit-card",
            "pages": [
              "GET /cards",
              "POST /cards",
              "GET /cards/{cardId}",
              "PATCH /cards/{cardId}",
              "DELETE /cards/{cardId}",
              "POST /cards/{cardId}/freeze",
              "POST /cards/{cardId}/unfreeze",
              "POST /cards/{cardId}/replace",
              "POST /cards/{cardId}/details",
              "GET /cards/{cardId}/policy",
              "GET /cards/{cardId}/intents",
              "POST /cards/{cardId}/intents",
              "GET /cards/{cardId}/access-events",
              "POST /cards/{cardId}/access"
            ]
          },
          {
            "group": "Intents",
            "icon": "bullseye",
            "pages": [
              "GET /intents/{intentId}",
              "DELETE /intents/{intentId}",
              "POST /intents/{intentId}/approve",
              "POST /intents/{intentId}/reject",
              "GET /intents/{intentId}/findings"
            ]
          },
          {
            "group": "Transactions",
            "icon": "money-bill-transfer",
            "pages": [
              "GET /transactions",
              "GET /transactions/{transactionId}",
              "PATCH /transactions/{transactionId}"
            ]
          },
          {
            "group": "Webhooks",
            "icon": "webhook",
            "pages": [
              "GET /webhooks",
              "POST /webhooks",
              "GET /webhooks/{webhookId}",
              "DELETE /webhooks/{webhookId}"
            ]
          },
          {
            "group": "KYC",
            "icon": "id-card",
            "pages": [
              "GET /kyc/applications",
              "POST /kyc/applications",
              "GET /kyc/applications/{applicationId}",
              "PATCH /kyc/applications/{applicationId}"
            ]
          },
          {
            "group": "Disputes",
            "icon": "gavel",
            "pages": [
              "GET /disputes",
              "GET /disputes/{disputeId}"
            ]
          },
          {
            "group": "Spend",
            "icon": "calculator",
            "pages": [
              "POST /spend/evaluate"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "MCP Server",
            "icon": "plug",
            "pages": [
              "mcp/introduction",
              "mcp/quickstart",
              "mcp/tools"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://useproxy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.useproxy.ai"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/proxy_os",
      "website": "https://useproxy.ai"
    }
  },
  "api": {
    "baseUrl": "https://api.useproxy.ai/v1",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "mode": "simple"
    }
  }
}
