{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Proxy",
  "colors": {
    "primary": "#1a1a1a",
    "light": "#85d7ff",
    "dark": "#85d7ff"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://useproxy.ai"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system",
    "rounded": "default"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "gradient"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "icon": "book",
            "pages": [
              "concepts/customers",
              "concepts/agents",
              "concepts/cards",
              "concepts/intents",
              "concepts/policies",
              "concepts/transactions",
              "concepts/balances",
              "concepts/disputes",
              "concepts/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "code",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "icon": "brackets-curly",
            "pages": [
              "api-reference/endpoints/customers",
              "api-reference/endpoints/agents",
              "api-reference/endpoints/cards",
              "api-reference/endpoints/intents",
              "api-reference/endpoints/transactions",
              "api-reference/endpoints/balances",
              "api-reference/endpoints/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "MCP Server",
            "icon": "plug",
            "pages": [
              "mcp/introduction",
              "mcp/quickstart",
              "mcp/tools"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://useproxy.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.useproxy.ai"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/proxy_os",
      "website": "https://useproxy.ai"
    }
  },
  "api": {
    "baseUrl": "https://api.useproxy.ai",
    "auth": {
      "method": "key",
      "name": "Authorization"
    },
    "playground": {
      "mode": "simple"
    }
  }
}
