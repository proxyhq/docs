  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://useproxy.ai"
      },
      {
        "label": "Pricing",
        "href": "https://useproxy.ai/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.useproxy.ai"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/proxy_os",
