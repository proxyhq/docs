    }
  },
  "api": {
    "baseUrl": "https://api.useproxy.ai",
    "auth": {
      "method": "key",
      "name": "Api-Key"
    },
    "playground": {
      "mode": "simple"
    }
  },
  "openapi": "openapi.json",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
